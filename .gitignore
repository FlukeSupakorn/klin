# ============================================================
# KLIN Project .gitignore
# ============================================================

# ************************************************************
#                    TAURI APP (src-tauri/)
# ************************************************************

# ===========================
# Node.js / React / TypeScript
# ===========================
node_modules/
dist/
dist-ssr/
*.local

# npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
build/
.next/
out/

# TypeScript
*.tsbuildinfo

# ===========================
# Rust / Cargo
# ===========================
target/
**/*.rs.bk
*.pdb

# ===========================
# Tauri Build
# ===========================
src-tauri/target/
src-tauri/WixTools/


# ************************************************************
#                    WORKER (worker/)
# ************************************************************

# ===========================
# Python Bytecode
# ===========================
__pycache__/
*.py[cod]
*$py.class
*.so

# ===========================
# Python Virtual Environments
# ===========================
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
virtualenv/
pyenv/
.conda/

# ===========================
# Python Packaging
# ===========================
*.egg-info/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
*.egg
MANIFEST

# ===========================
# Jupyter Notebook
# ===========================
.ipynb_checkpoints/
*.ipynb_checkpoints/

# ===========================
# PyInstaller
# ===========================
*.manifest
*.spec

# ===========================
# ML Models / OCR / LLM
# ===========================
# Large model files
*.bin
*.gguf
*.safetensors
*.pt
*.pth
*.ckpt
*.h5
*.pb
*.onnx
*.tflite
*.mlmodel

# Model directories
checkpoints/
saved_models/
weights/
pretrained/
trained_models/

# OCR specific
tesseract/
tessdata/
*.traineddata

# Training outputs
runs/
tensorboard/
wandb/

# ===========================
# Worker Databases
# ===========================
**/db/lancedb/
**/*.lance/
**/db/sqlite/

# ************************************************************
#                    SHARED / GLOBAL
# ************************************************************

# ===========================
# Environment & Secrets
# ===========================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.key
*.pem
secrets.json
credentials.json
.secrets/

# ===========================
# IDE / Editors
# ===========================
# VSCode
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.code-workspace

# JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# ===========================
# Operating System
# ===========================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Linux
.directory
.Trash-*

# ===========================
# Testing
# ===========================
coverage/
*.lcov
.nyc_output/
.coverage
.pytest_cache/
htmlcov/
.tox/

# ===========================
# Logs & Temp Files
# ===========================
logs/
*.log
tmp/
temp/
*.tmp
*.temp
*.cache

# ===========================
# Lock Files
# ===========================
yarn.lock
pnpm-lock.yaml

# ===========================
# Database Files
# ===========================
*.db
*.sqlite
*.sqlite3

# ===========================
# Compressed Files
# ===========================
*.zip
*.tar.gz
*.rar
*.7z

# ===========================
# Misc
# ===========================
prompt

# ===========================
# JSON File Exceptions
# ===========================
!package.json
!tsconfig.json
!tsconfig.node.json
!tauri.conf.json