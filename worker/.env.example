# ============================================================
# Klin Worker – Environment Configuration
# ============================================================

# ---------- Ollama ----------
OLLAMA_BASE_URL=http://127.0.0.1:11434
MODEL_NAME=qwen3-vl:2b
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_DIM=1024
HTTP_TIMEOUT=120

# ---------- RAG-Anything / LightRAG ----------
RAG_WORKING_DIR=./rag_storage
RAG_PARSER=mineru
RAG_PARSE_METHOD=auto
RAG_ENABLE_IMAGE_PROCESSING=true
RAG_ENABLE_TABLE_PROCESSING=true
RAG_ENABLE_EQUATION_PROCESSING=true
RAG_OUTPUT_DIR=./output

# ---------- Server ----------
PORT=8989
HOST=0.0.0.0
LOG_LEVEL=INFO
LOG_FORMAT=text